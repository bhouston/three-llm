{
  "name": "three-llm-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "tsc": "tsc -b",
    "dev": "pnpm --parallel --filter three-llm --filter website dev",
    "start": "pnpm --filter website start",
    "test": "vitest run --project library --project website",
    "test:unit": "pnpm tsc && vitest run --project library --project website",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:browser": "vitest run --project library-webgpu-node",
    "test:checkpoints": "vitest run --project checkpoints --project checkpoints-webgpu-node",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "pnpm test && pnpm test:e2e",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "make-release": "pnpm release --dry-run",
    "gcloud": "gcloud auth application-default login && gcloud config set account \"neuralsoft@gmail.com\" && gcloud config set project bhouston-general-hosting && gcloud config set run/region us-central1",
    "test:coverage": "pnpm test --coverage",
    "size": "size-limit",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.61.1",
    "@semantic-release/changelog": "^7.0.0",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^22.20.0",
    "@visulima/yaml": "1.0.0",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.61.1",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^5.0.1",
    "vitest-environment-webgpu-node": "^2.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "size-limit": [
    {
      "name": "three-llm compiled JavaScript (Brotli, excluding peer dependencies)",
      "path": "packages/three-llm/dist/**/*.js",
      "limit": "70 kB"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
