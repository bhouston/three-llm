{
  "extends": "../../tsconfig.node.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "vgpu-llm": ["../vgpu-llm/src/index.ts"],
      "vgpu-llm/catalog": ["../vgpu-llm/src/catalog.ts"]
    }
  },
  "references": [{ "path": "../vgpu-llm" }]
}
